# Apache (Strato): alle Pfade wie /team auf die App leiten, echte Dateien direkt ausliefern.
RewriteEngine On
RewriteBase /lotse/
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ /lotse/index.html [L]

# Fiktives Studio: nicht in Suchmaschinen (gleich wie das Meta-Tag in index.html)
Header set X-Robots-Tag "noindex, nofollow"

<IfModule mod_expires.c>
  ExpiresActive On
  # Dateien mit Hash im Namen ändern sich nie: lange cachen
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  # Die Seite selbst immer frisch
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
