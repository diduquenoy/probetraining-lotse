# All-Inkl (Apache): alle Pfade wie /team auf die App leiten, echte Dateien direkt ausliefern.
RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

# Prototyp nicht in Suchmaschinen
Header set X-Robots-Tag "noindex, nofollow"
